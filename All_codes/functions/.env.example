# For local testing only (firebase emulators:start / functions:shell).
# Copy to functions/.env — it is gitignored and never deployed; production
# secrets are set via `firebase functions:secrets:set <NAME>` instead.
# GEMINI_API_KEY is the primary model for chat + boarding-pass vision;
# GROQ_API_KEY is used automatically as the fallback if Gemini is unset,
# errors, or times out.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AVIATIONSTACK_KEY=
