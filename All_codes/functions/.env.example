# Client-side (Vite) — safe to expose in the browser bundle.
# These are Firebase's public web-app identifiers, not secrets; access
# control is enforced by Firestore security rules and Cloud Functions
# auth checks, not by hiding this config. See vite.config.ts.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Real secrets (GROQ_API_KEY, OPENSKY_CLIENT_ID/SECRET, AVIATIONSTACK_KEY)
# never belong in this file anymore — they live server-side only, set via:
#   firebase functions:secrets:set GROQ_API_KEY
#   firebase functions:secrets:set OPENSKY_CLIENT_ID
#   firebase functions:secrets:set OPENSKY_CLIENT_SECRET
#   firebase functions:secrets:set AVIATIONSTACK_KEY
# See functions/.env.example for local emulator testing.
