# AeroMind native backend. Copy to server/.env — gitignored, server-side only.
# None of these ever reach the browser; the client talks to this API instead.

PORT=8080
# Comma-separated origins allowed to call this API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Path to the Firebase service account JSON, relative to server/.
# Used only to verify ID tokens and read Firestore. Omit to fall back to
# GOOGLE_APPLICATION_CREDENTIALS / gcloud application-default credentials.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Gemini is primary for chat + boarding-pass vision; Groq is the automatic
# fallback when Gemini is unset, errors, or times out.
GEMINI_API_KEY=
GROQ_API_KEY=
AVIATIONSTACK_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
