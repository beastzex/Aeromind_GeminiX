# Client-side (Vite) — safe to expose in the browser bundle.
# These are Firebase's public web-app identifiers, not secrets; access
# control is enforced by Firestore security rules and the native backend's
# ID-token verification, not by hiding this config. See vite.config.ts.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Real secrets (GEMINI_API_KEY, GROQ_API_KEY, OPENSKY_CLIENT_ID/SECRET,
# AVIATIONSTACK_KEY, DEEPGRAM_API_KEY) never belong in this file — they live
# server-side only, in server/.env (gitignored, copy from server/.env.example).
# There's no Firebase Functions / Secret Manager involved anymore: the native
# backend in server/ reads these as plain process.env vars.
#
# GEMINI_API_KEY: Google AI Studio key. Primary model for chat + boarding-pass
#   vision (server/src/lib/aiProviders.ts, Groq is the automatic fallback),
#   and also mints single-use ephemeral Voice Live API tokens
#   (server/src/lib/mintVoiceToken.ts).
# DEEPGRAM_API_KEY: Deepgram project key (Member role or higher), used
#   server-side only to mint short-lived Voice Agent grant tokens.
